# Copy to staging.tfvars and fill. db_password comes via TF_VAR_db_password (never commit the real file).
# TLS certs + DNS records are now created automatically in the Route 53 zone (route53_zone_name, default kanzen.family)
# — no cert ARNs to supply. The web is served at domain_name, the API at api.<domain_name>.
domain_name       = "staging.kanzen.family"
nixos_ami_id      = "ami-REPLACE" # published by CI's NixOS image build (nix build .#amazon-image → register)
instance_type     = "t3.small"
db_instance_class = "db.t3.small"
ssh_cidr_blocks   = [] # add the ops VPN CIDR if SSH is needed
# route53_zone_name defaults to "kanzen.family" — override only if the zone differs.
# db_password — supply via:  export TF_VAR_db_password="$(openssl rand -base64 24)"
